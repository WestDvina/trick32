{{ printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
<rss version="2.0"
  xmlns:content="http://purl.org/rss/1.0/modules/content/"
  xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>Уловка-32 — Дзен</title>
    <link>{{ "/dzen/" | absURL }}</link>
    <description>Технологии без фанатизма: Windows, Microsoft и практические разборы</description>
    <language>ru</language>
    {{ range first 30 .Pages.ByDate.Reverse }}
      {{- $cover := .Params.cover -}}
      {{- if not $cover -}}
        {{- $cover = printf "/og/%s.jpg" .File.ContentBaseName -}}
      {{- end -}}
      {{- $published := .Date -}}
      {{- with .Params.dzen_pubdate -}}
        {{- $published = time . -}}
      {{- end -}}
      {{- $body := .Content -}}
      {{- $body = replaceRE `<span[^>]*>` `` $body -}}
      {{- $body = replaceRE `</span>` `` $body -}}
      {{- $body = replaceRE ` class="[^"]*"` `` $body -}}
      {{- $body = replaceRE `src="/([^"]+)"` `src="https://trick32.ru/$1"` $body -}}
      {{- $body = replaceRE `srcset="[^"]*"` `` $body -}}
      {{- $body = replaceRE `href="/([^"]+)"` `href="https://trick32.ru/$1"` $body -}}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid>{{ .Permalink }}</guid>
      <pubDate>{{ $published.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <category>format-article</category>
      <category>index</category>
      <category>comment-all</category>
      <description>{{ .Description }}</description>
      <enclosure url="{{ $cover | absURL }}" type="image/jpeg" length="0" />
      <content:encoded>{{ printf "<![CDATA[%s]]>" $body | safeHTML }}</content:encoded>
    </item>
    {{ end }}
  </channel>
</rss>
